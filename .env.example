APP_NAME=kuairand-recsys
ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
METRICS_HOST=0.0.0.0
METRICS_PORT=9001

REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_KEY=events_stream
REDIS_STREAM_GROUP=events_workers
REDIS_STREAM_CONSUMER=worker-1
REDIS_SLATE_STREAM_KEY=slate_stream
REDIS_DLQ_STREAM_KEY=events_dlq

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

POSTGRES_DSN=postgresql://recsys:recsys@localhost:5432/recsys

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=items_v1
QDRANT_VECTOR_SIZE=128

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_PREFIX=kuairand-recsys
MODEL_VERSION=retrieval-pop-v1
ALS_ARTIFACT_DIR=artifacts/als_v2
BPR_ARTIFACT_DIR=artifacts/bpr_v1
TWO_TOWER_ARTIFACT_DIR=artifacts/twotower_v1
RANKER_ARTIFACT_DIR=artifacts/ranker_v1
BLEND_MODEL_PATH=artifacts/ranker_v1/blend_model.cbm
CANDIDATE_DEFAULT_K=500
ENABLE_TWO_TOWER=true
ALS_WEIGHT=1.0
BPR_WEIGHT=1.0
TWO_TOWER_WEIGHT=1.0
RECOMMEND_FEATURE_TIMEOUT_MS=30
RECOMMEND_RETRIEVAL_TIMEOUT_MS=60
RECOMMEND_RANKING_TIMEOUT_MS=60
RECOMMEND_TOTAL_TIMEOUT_MS=150
AUTO_LOG_IMPRESSIONS=true
AUTO_LOG_SLATES=true
